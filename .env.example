# Environment Variables Example
# Copy this file to .env.local and update with your values

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://tsvetkov.site
NEXT_PUBLIC_SITE_NAME=Tsvetkov Portfolio

# Optional: Analytics
# NEXT_PUBLIC_GA_ID=your-google-analytics-id

# Optional: Contact Email
# CONTACT_EMAIL=contact@tsvetkov.site

# ─── SERVER-SIDE ONLY ─────────────────────────────────
# Contact Form Webhook (Make/Zapier/Custom endpoint)
# This URL receives form submissions from /api/contact
# WARNING: Do NOT prefix with NEXT_PUBLIC_ — this is server-only
WEBHOOK_URL=https://hooks.make.com/your-webhook-url
