# Environment Variables Example
# Copy this file to .env.local and update with your values

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://tsvetkov.site
NEXT_PUBLIC_SITE_NAME=Tsvetkov Portfolio

# Optional: Analytics
# NEXT_PUBLIC_GA_ID=your-google-analytics-id

# Optional: Contact Email
# CONTACT_EMAIL=contact@tsvetkov.site

# ─── SERVER-SIDE ONLY ─────────────────────────────────
# Contact Form Delivery (Resend)
# /api/contact uses this to email form submissions to fedor@tsvetkov.site
# WARNING: Do NOT prefix with NEXT_PUBLIC_ — this is server-only
RESEND_API_KEY=re_your_resend_api_key

# Optional: override the sending address (defaults to noreply@tsvetkov.site,
# which requires the domain to be verified in Resend)
# RESEND_FROM_EMAIL=Tsvetkov Site <noreply@tsvetkov.site>
